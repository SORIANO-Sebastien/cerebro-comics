[Unit]
Description=Cerebro Comics Web Server
Documentation=https://github.com/votre-nom/comics-manager
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/comics-manager
ExecStart=/usr/bin/node /opt/comics-manager/serveur_reseau.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOST=0.0.0.0

[Install]
WantedBy=multi-user.target
